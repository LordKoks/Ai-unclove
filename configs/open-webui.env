# Open WebUI Configuration
# This file contains settings for the Open WebUI interface

# OpenAI API endpoint (change based on your setup)
# For weak PC: http://192.168.1.100:8080/v1
# For strong PC: http://192.168.1.200:8080/v1
# For local: http://host.docker.internal:8080/v1
OPENAI_API_BASE_URL=http://host.docker.internal:8080/v1

# API Key (not required for local setup, but must be set)
OPENAI_API_KEY=sk-no-key-required

# WebUI Settings
WEBUI_NAME=AI-unclove Local LLM
ENABLE_SIGNUP=true
ENABLE_COMMUNITY_SHARING=false
ENABLE_MESSAGE_RATING=true

# API Toggles
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true

# Security (change this in production!)
WEBUI_SECRET_KEY=change-this-to-random-secret-key

# Default models (leave empty to show all)
DEFAULT_MODELS=
