# Environment configuration for strong PC setup
# vLLM with maximum performance

# Model Configuration
MODEL_NAME=model
TENSOR_PARALLEL=1
DTYPE=auto
MAX_MODEL_LEN=32768

# Performance Settings
GPU_MEMORY_UTIL=0.9
CUDA_VISIBLE_DEVICES=0

# vLLM Optimizations
VLLM_USE_MODELSCOPE=false
VLLM_WORKER_MULTIPROC_METHOD=spawn

# Cache Settings
HF_HOME=/root/.cache/huggingface
