# Environment configuration for weak PC setup
# llama.cpp with TurboQuant + OpenVINO NPU

# Model Configuration
MODEL_NAME=model.gguf
N_GPU_LAYERS=99
CONTEXT_SIZE=32768
MAX_TOKENS=2048

# TurboQuant Settings (3-bit KV-cache compression)
CACHE_TYPE_K=turbo3
CACHE_TYPE_V=turbo3

# OpenVINO NPU Settings
GGML_OPENVINO_DEVICE=NPU

# CUDA Fallback (for GTX 1660)
CUDA_VISIBLE_DEVICES=0

# Performance Tuning
GGML_CPU_HBM=1
OMP_NUM_THREADS=8
